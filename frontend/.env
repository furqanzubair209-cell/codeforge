# URL of your deployed execution-service (see ../execution-service and ../README.md).
# Without this set, the app runs fine for browsing/topics/dashboard, but the
# Run and Submit buttons on the problem workspace will show a clear inline notice
# instead of silently failing.
#
# Local dev example:
# VITE_EXECUTION_API_URL=http://localhost:8080
#
# Production example (after deploying execution-service to Render/Fly/a VPS):
# VITE_EXECUTION_API_URL=https://codeforge-execution.onrender.com
VITE_EXECUTION_API_URL=http://localhost:8080
